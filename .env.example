# harness2 deployment settings. Copy to .env and fill in; shell values override .env.
# Every key is read by harness2/config.py.

# Executor model, in OpenCode's provider/model format.
HARNESS2_SOLVER_MODEL=
# Improver model, same format; defaults to the executor model.
HARNESS2_IMPROVER_MODEL=
# Bare judge model ID; the benchmark adapter supplies the Vertex prefix.
HARNESS2_JUDGE_MODEL=

# Google Cloud project for Vertex AI.
GOOGLE_CLOUD_PROJECT=
# Vertex region; defaults to "global".
GOOGLE_CLOUD_LOCATION=global
# Alternative to GOOGLE_CLOUD_PROJECT, read by harness2 only.
HARNESS2_VERTEX_PROJECT=

# Root of the runs/ output tree; defaults to ./runs.
HARNESS2_RUNS_DIR=

# Codex substrate (Responses API endpoint). harness2-bridge prints these.
HARNESS2_CODEX_BASE_URL=
# Bridge URL reachable from Docker containers (WorkBuddy); printed by harness2-bridge.
HARNESS2_CODEX_CONTAINER_URL=
# Access key for the bridge endpoint.
HARNESS2_CODEX_API_KEY=
# Executor model for the Codex substrate; defaults to the executor's model ID.
HARNESS2_CODEX_MODEL=

# Judge endpoint overrides; leave empty to use Vertex AI.
HARNESS2_JUDGE_BASE_URL=
# API key for a non-Vertex judge endpoint.
HARNESS2_JUDGE_API_KEY=
